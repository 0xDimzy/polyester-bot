# --- kredensial (sama seperti skrip lama; dukung banyak akun _1, _2, ...) ---
POLYESTER_API_KEY_ID_1=
POLYESTER_API_PRIVATE_KEY_1=
POLYESTER_ACCOUNT_ID_1=

# akun kedua dan seterusnya: duplikasi blok di atas dengan suffix _2, _3, ...
# (penomoran harus mulai dari _1, dan tiap account_id harus unik)
# POLYESTER_API_KEY_ID_2=
# POLYESTER_API_PRIVATE_KEY_2=
# POLYESTER_ACCOUNT_ID_2=

# --- pasar ---
BOT_QUOTES=USDT,USDC
# BOT_PAIRS=BTC-USDT,ETH-USDT

# --- mode ---
BOT_DRY_RUN=0
BOT_CANCEL_ON_START=1
BOT_CYCLE_DELAY=15
BOT_ORDER_DELAY=0.3

# --- strategi kuotasi ---
# 0 = kuotasi semua pair yang punya book (mode volume). Isi 1 = kalau mau hanya
# pair yang spread-nya menutup 2*fee + edge.
BOT_PROFITABLE_ONLY=0
BOT_MIN_SPREAD_BPS=0
BOT_MIN_EDGE_BPS=1
BOT_DEFAULT_MAKER_BPS=2
# 0 = join best bid/ask, 1 = maju satu tick ke tengah spread
BOT_IMPROVE_TICKS=0

# --- ukuran & manajemen order ---
BOT_ORDER_PCT=1.5
BOT_ORDER_TTL=120
BOT_REPRICE_BPS=5
BOT_MIN_ORDER_AGE=15
BOT_INV_BAND=0.5

# --- pengaman ---
BOT_MAX_DRAWDOWN_PCT=3
BOT_MAX_ERRORS=10
BOT_MAX_CYCLE_FAILS=8
BOT_MAX_CYCLES=0

# --- fallback volume: kalau maker tidak kena selama N detik, ambil likuiditas ---
# 0 = matikan
BOT_TAKER_AFTER=300
BOT_MAX_TAKER_SPREAD_BPS=60
BOT_SLIPPAGE_BPS=100

# --- pendanaan ulang (jual aset lain kalau quote tipis) ---
BOT_QUOTE_MIN_PCT=8
BOT_QUOTE_TARGET_PCT=20
BOT_REFILL_MAX_FRAC=0.3
BOT_REFILL_MAX_ORDERS=4
